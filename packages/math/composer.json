{
    "name": "papercut/math",
    "description": "Math layout for PHP: fractions, roots, scripts and stretchy delimiters from an OpenType MATH font, with SVG, MathML and Word OMML writers.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/One-Learning-Community/papercut",
    "support": {
        "issues": "https://github.com/One-Learning-Community/papercut/issues",
        "source": "https://github.com/One-Learning-Community/papercut"
    },
    "authors": [
        {
            "name": "One Learning Community",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "math",
        "equations",
        "mathml",
        "omml",
        "svg",
        "opentype",
        "papercut"
    ],
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Papercut\\Math\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Papercut\\Math\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.12.x-dev"
        }
    }
}
